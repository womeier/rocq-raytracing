+/-- `render --name spheres --scene 2 --width 320 --samples 16 --depth 30
+--threads 1 --out out.ppm` -/
+def parseArgs : List String → RenderOpts → Except String RenderOpts
+  | [], o => .ok o
+  | [k], _ => .error s!"{k} wants a value"
+  | k :: v :: rest, o => do
+    let nat : Except String Nat := match v.toNat? with
+      | some n => .ok n
+      | none => .error s!"{k} wants a number, got {v}"
+    let o ← match k with
+      | "--out" | "--filename" => pure { o with filename := v }
+      | "--name" => pure { o with name := v }
+      | "--width" => pure { o with width := ← nat }
+      | "--height" => pure { o with height := ← nat }
+      | "--samples" => pure { o with samplesPerPixel := ← nat }
+      | "--depth" => pure { o with maxDepth := ← nat }
+      | "--scene" => pure { o with scene := ← nat }
+      | "--limit" => pure { o with limit := ← nat }
+      | "--threads" => pure { o with numThreads := ← nat }
+      | _ => .error s!"unknown option {k}"
+    parseArgs rest o
+
+def main (args : List String) : IO Unit := do
+  match parseArgs args {} with
+  | .error e => throw <| IO.userError e
+  | .ok o => writeTestImage o
