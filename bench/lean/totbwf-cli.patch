+/-- `trace [<path>] [<name>]`: renders the fixed 512x256 image, and prints one
+JSON line of timings, so that the run can be compared with the Rocq one. -/
+def main (args : List String) : IO UInt32 := do
+  let path := args.getD 0 "img.ppm"
+  let name := args.getD 1 "first-light"
+  let pixels := render (Object.sphere 0.5 ⟨ 0, 0, -1.0 ⟩)
+  -- A Matrix is a function, so nothing is computed until a pixel is demanded:
+  -- the timed phase is this one, which demands all of them, and writing the
+  -- file afterwards is outside it (the Rocq side is timed the same way).
+  let acc ← IO.mkRef (#[] : Array Pixel)
+  let tRender ← IO.monoMsNow
+  traverse_ pixels (fun px => acc.modify (·.push px))
+  let renderMs := (← IO.monoMsNow) - tRender
+  let shot ← acc.get
+  FS.withFile path FS.Mode.write fun handle => do
+    FS.Handle.putStrLn handle "P3"
+    FS.Handle.putStrLn handle "512 256"
+    FS.Handle.putStrLn handle "255"
+    for px in shot do
+      FS.Handle.putStrLn handle (toString px)
+  let secs (ms : Nat) : String := toString (Float.ofNat ms / 1000.0)
+  IO.println <| "{\"name\": \"" ++ name ++ "\", \"impl\": \"lean\", \"scene\": 0"
+    ++ ", \"width\": 512, \"height\": 256, \"samples\": 1, \"depth\": 1"
+    ++ ", \"threads\": 1, \"prepare_s\": 0.0"
+    ++ ", \"render_s\": " ++ secs renderMs
+    ++ ", \"total_s\": " ++ secs renderMs
+    ++ ", \"image\": \"" ++ path ++ "\"}"
   return 0
